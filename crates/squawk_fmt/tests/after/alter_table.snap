    /* set */ set /* default */ default
      /* expression */ 'A very long default activity description used to verify formatter wrapping behavior',
  /* comma */ rename /* column */ column /* old name */ old_activity_code /* to */ to /* new name */ current_activity_code/* semicolon */;

