create operator class integer_minmax_ops
  default for type integer
  using btree as
  operator 1 < for search,
  function 1 (integer, integer) int4cmp(integer, integer),
  storage integer;

create operator class extraordinarily_long_schema_name.extraordinarily_long_integer_operator_class
  default for type extraordinarily_long_schema_name.extraordinarily_long_integer_type
  using extraordinarily_long_access_method
  family extraordinarily_long_schema_name.extraordinarily_long_operator_family as
  operator 1 < (
    extraordinarily_long_schema_name.extraordinarily_long_integer_type,
    extraordinarily_long_schema_name.extraordinarily_long_integer_type
  )
  for order by extraordinarily_long_schema_name.extraordinarily_long_sort_family,
  function 1 (
    extraordinarily_long_schema_name.extraordinarily_long_integer_type,
    extraordinarily_long_schema_name.extraordinarily_long_integer_type
  )
  extraordinarily_long_schema_name.extraordinarily_long_comparison_function(
    extraordinarily_long_schema_name.extraordinarily_long_integer_type,
    extraordinarily_long_schema_name.extraordinarily_long_integer_type
  ),
  storage extraordinarily_long_schema_name.extraordinarily_long_storage_type;

