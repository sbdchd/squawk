  /*g*/ in /*h*/ value /*i*/ integer /*j*/ default /*k*/ 1 /*l*/,
  /*m*/ out /*n*/ result /*o*/ text /*p*/
) /*q*/ returns /*r*/ table /*s*/ (
  /*t*/ id /*u*/ bigint /*v*/,
  /*w*/ label /*x*/ text /*y*/
) /*z*/
  language /*aa*/ sql
  /*ab*/ immutable
  /*ac*/ strict
  /*ad*/ parallel /*ae*/ safe
  /*af*/ cost /*ag*/ 10
