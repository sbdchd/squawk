select * from generate_series(1, 3);
select * from lateral generate_series(1, 3) with ordinality as g (n, ord);
select *
from /* before lateral */ lateral /* before call */ generate_series /* before opening paren */(
    /* before first argument */ 1 /* before comma */,
    /* before second argument */ 3 /* before closing paren */
  ) /* before with */ with /* before ordinality */ ordinality /* before alias */ as /* before alias name */ g /* before alias opening paren */ (
