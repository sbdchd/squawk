from lateral a_very_long_function_name(
    a_very_long_first_argument_name,
    a_very_long_second_argument_name,
    a_very_long_third_argument_name
  ) with ordinality as a_very_long_function_alias (
    a_very_long_value_column_alias,
    a_very_long_ordinality_column_alias
  );
