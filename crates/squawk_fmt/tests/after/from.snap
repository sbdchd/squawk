select *
from xmltable(
  '/rows/row' passing doc
  columns
    id int8 path '@id' not null,
    ord for ordinality,
    value text default 'unknown' null
) as parsed;
select *
from lateral xmltable(
  xmlnamespaces('urn:a' as a, default 'urn:default'),
  a_very_long_xml_row_expression passing by ref
