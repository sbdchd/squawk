SOURCE_FILE
  SELECT
    SELECT_CLAUSE
      SELECT_KW "select"
      WHITESPACE " "
      TARGET_LIST
        TARGET
          STAR "*"
    WHITESPACE " "
    FROM_CLAUSE
      FROM_KW "from"
      WHITESPACE " "
      RELATION_FROM_ITEM
        RELATION_NAME_REF
          PATH_REF
            PATH_SEGMENT_REF
              TREAT_KW "treat"
        WHITESPACE " "
        STAR "*"
    SEMICOLON ";"
  WHITESPACE "\n"
