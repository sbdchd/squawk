SOURCE_FILE
  COMMENT "-- INTERSECT has stronger precedence than UNION"
  WHITESPACE "\n"
  COMPOUND_SELECT
    COMPOUND_SELECT
      SELECT
        SELECT_CLAUSE
          SELECT_KW "select"
          WHITESPACE " "
          TARGET_LIST
            TARGET
              LITERAL
                INT_NUMBER "1"
