    WHITESPACE " "
    SELECT
      SELECT_CLAUSE
        SELECT_KW "select"
        WHITESPACE " "
        TARGET_LIST
          TARGET
            LITERAL
              INT_NUMBER "3"
    SEMICOLON ";"
  WHITESPACE "\n"
  COMMENT "-- so this is:"
  WHITESPACE "\n"
