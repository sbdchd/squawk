    SET_KW "set"
    WHITESPACE " "
    SET_TIME_ZONE
      TIME_KW "time"
      WHITESPACE " "
      ZONE_KW "zone"
      WHITESPACE " "
      CONFIG_VALUE_NAME
        IDENT "now"
  ERROR
    L_PAREN "("
  ERROR
    R_PAREN ")"
  EMPTY_STMT
    SEMICOLON ";"
  WHITESPACE "\n\n"
  COMMENT "-- zone_value doesn't accept NULL"
  WHITESPACE "\n"
  SET
    SET_KW "set"
    WHITESPACE " "
    SET_TIME_ZONE
      TIME_KW "time"
      WHITESPACE " "
      ZONE_KW "zone"
  WHITESPACE " "
  ERROR
    NULL_KW "null"
  EMPTY_STMT
    SEMICOLON ";"
  WHITESPACE "\n\n"
  COMMENT "-- configuration value lists cannot have a trailing comma"
  WHITESPACE "\n"
  SET
    SET_KW "set"
    WHITESPACE " "
    SET_CONFIG
      CONFIG_PARAMETER_REF
        PATH_REF
          PATH_SEGMENT_REF
            IDENT "s"
      TO_CONFIG_VALUE
        EQ "="
        LITERAL
          STRING "''"
        COMMA ","
        CONFIG_VALUE_NAME
          IDENT "F"
        COMMA ","
        LITERAL
          STRING "''''"
        COMMA ","
    SEMICOLON ";"
  WHITESPACE "\n\n"
  SET
    SET_KW "set"
    WHITESPACE " "
    SET_CONFIG
      CONFIG_PARAMETER_REF
        PATH_REF
          PATH_SEGMENT_REF
            IDENT "c"
      TO_CONFIG_VALUE
        EQ "="
        LITERAL
          STRING "''"
        COMMA ","
    SEMICOLON ";"
  WHITESPACE "\n\n"
  SET
    SET_KW "set"
    WHITESPACE " "
    SET_CONFIG
      CONFIG_PARAMETER_REF
        PATH_REF
          PATH_SEGMENT_REF
            IDENT "m"
      TO_CONFIG_VALUE
        EQ "="
        LITERAL
          INT_NUMBER "2"
        COMMA ","
  WHITESPACE "\n"
