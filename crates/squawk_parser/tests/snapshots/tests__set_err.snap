SOURCE_FILE
  COMMENT "-- zone_value is a single value, not a list"
  WHITESPACE "\n"
  SET
    SET_KW "set"
    WHITESPACE " "
    SET_TIME_ZONE
      TIME_KW "time"
      WHITESPACE " "
      ZONE_KW "zone"
      WHITESPACE " "
      LITERAL
