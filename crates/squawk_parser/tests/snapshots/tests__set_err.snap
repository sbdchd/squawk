    COMMA ","
  WHITESPACE " "
  ERROR
    STRING "'b'"
  EMPTY_STMT
    SEMICOLON ";"
  WHITESPACE "\n\n"
  COMMENT "-- zone_value doesn't allow arbitrary expressions"
  WHITESPACE "\n"
