    "\\gset x_" @ PsqlCommand { ends_query: true },
    "\n" @ Whitespace,
    "select" @ Ident,
    " " @ Whitespace,
    "$1" @ PositionalParam { trailing_junk_start: 2 },
    " " @ Whitespace,
    "\\parse stmt" @ PsqlCommand { ends_query: true },
    "\n" @ Whitespace,
    "select" @ Ident,
    " " @ Whitespace,
    "2" @ Literal { kind: Int { base: Decimal, empty_int: false, trailing_junk_start: 1 } },
    " " @ Whitespace,
    "\\r" @ PsqlCommand { ends_query: true },
]
