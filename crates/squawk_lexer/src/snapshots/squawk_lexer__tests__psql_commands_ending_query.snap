---
source: crates/squawk_lexer/src/lib.rs
expression: "lex(r\"select 1 \\echo x \\gset x_\nselect $1 \\parse stmt\nselect 2 \\r\")"
---
[
    "select" @ Ident,
    " " @ Whitespace,
    "1" @ Literal { kind: Int { base: Decimal, empty_int: false, trailing_junk_start: 1 } },
    " " @ Whitespace,
