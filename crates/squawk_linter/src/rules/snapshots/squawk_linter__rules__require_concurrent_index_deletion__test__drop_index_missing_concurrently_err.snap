warning[require-concurrent-index-deletion]: a normal `drop index` acquires an `access exclusive` lock on the table, blocking other accesses until the index drop can complete
  ╭▸ 
3 │   DROP INDEX IF EXISTS "field_name_idx";
  │   ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  │
  ├ help: drop the index `concurrently`
  ╭╴
3 │   DROP INDEX concurrently IF EXISTS "field_name_idx";
  ╰╴             ++++++++++++
