---
source: crates/squawk_syntax/src/test.rs
input_file: crates/squawk_parser/tests/data/plpgsql/ok/null_stmt.sql
---
PLPGSQL@0..27
  WHITESPACE@0..1 "\n"
  PLPGSQL_BLOCK@1..26
    BEGIN_KW@1..6 "begin"
    WHITESPACE@6..9 "\n  "
    PLPGSQL_BODY@9..22
      PLPGSQL_NULL_STMT@9..14
        NULL_KW@9..13 "null"
        SEMICOLON@13..14 ";"
      WHITESPACE@14..17 "\n  "
      PLPGSQL_NULL_STMT@17..22
        NULL_KW@17..21 "null"
        SEMICOLON@21..22 ";"
    WHITESPACE@22..23 "\n"
    END_KW@23..26 "end"
  WHITESPACE@26..27 "\n"
