  JsonWrapperBehaviorClause?
  JsonQuotesClause?
  JsonOnEmptyClause?
  JsonOnErrorClause?

JsonTableExistsColumn =
  ColumnName Type
  'exists'
  JsonPathClause?
  JsonOnErrorClause?

JsonTableNestedColumn =
  'nested' 'path'? Expr JsonPathNameClause? JsonTableColumnList

JsonPathClause =
  'path' Expr

