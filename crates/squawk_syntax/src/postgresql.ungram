| NotLeakproofFuncOption
| ResetFuncOption
| VolatilityFuncOption
| WindowFuncOption
| TransformFuncOption
| LanguageFuncOption



CreateFunction =
  'create' OrReplace? 'function' name:FunctionName ParamList RetType? option_list:FuncOptionList body:RoutineBody? ';'?

